{
    "compilerOptions": {
        "target": "ES2024",
        "lib": [
            "ES2024"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "types": [
            "node"
        ],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "vite.config.ts"
    ]
}